# Cloudflare Pages redirects. Copied verbatim from public/ into dist/ by Vite.
#
# Each client-side route is answered with the single page application (status 200: a rewrite, the
# address does not change). `/` is index.html itself. There is deliberately no catch-all: an unknown
# path or a missing /assets/* file falls through to 404.html and a real 404 status. A test keeps
# this list equal to ROUTE_PATHS in src/app/route-paths.ts.

/learn /index.html 200
/stats /index.html 200
/settings /index.html 200
/about /index.html 200
