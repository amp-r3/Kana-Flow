# Cloudflare Pages headers. Copied verbatim from public/ into dist/ by Vite.

# Hashed build output never changes under the same name -> cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry point must always be revalidated so new deploys are picked up.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=()
