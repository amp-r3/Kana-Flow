#!/bin/sh
# Full verification before code leaves the machine: the same `verify` that CI runs
# (typecheck, lint, formatting, unit tests with coverage, build, size budgets, e2e).
# The output is not silenced: `--silent` is inherited by the nested pnpm calls and hid the output of a
# failing e2e run, which showed only as "failed to push some refs".
# A push that changes only Markdown files skips it and checks formatting instead: no code changed, and CI
# still runs the full `verify` on the pull request.
# Bypass in an emergency with `git push --no-verify`.
set -eu

base=$(git merge-base origin/main HEAD 2>/dev/null || true)
if [ -n "$base" ]; then
  changed=$(git diff --name-only "$base" HEAD)
  if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -qv '\.md$'; then
    printf '%s\n' "$changed" | tr '\n' '\0' | xargs -0 pnpm exec prettier --check --ignore-unknown
    exit 0
  fi
fi

pnpm run verify
