#!/bin/sh
# Verification before code leaves the machine: `verify:quick`, which is `verify` without the browser
# tests (typecheck, lint, formatting, unit tests with coverage, build, size budgets). The e2e run in CI
# on every pull request and the latency test on `main` before the deploy (ADR 052); run them here by
# hand with `pnpm run e2e` when a change touches browser behaviour.
# The output is not silenced: `--silent` is inherited by the nested pnpm calls and would hide the output of
# a failing step, which showed only as "failed to push some refs".
# A push that changes only Markdown files skips it and checks formatting instead: no code changed, and CI
# still runs the full `verify` on the pull request.
# Bypass in an emergency with `git push --no-verify`.
set -eu

base=$(git merge-base origin/main HEAD 2>/dev/null || true)
if [ -n "$base" ]; then
  changed=$(git diff --name-only "$base" HEAD)
  if [ -n "$changed" ] && ! printf '%s\n' "$changed" | grep -qv '\.md$'; then
    printf '%s\n' "$changed" | tr '\n' '\0' | xargs -0 pnpm exec prettier --check --ignore-unknown
    exit 0
  fi
fi

pnpm run verify:quick
